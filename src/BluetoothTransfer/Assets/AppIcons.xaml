<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 应用主色 -->
    <SolidColorBrush x:Key="BrandBrush" Color="#0B6BCB"/>
    <SolidColorBrush x:Key="BrandDarkBrush" Color="#0958A8"/>

    <!--
      应用图标（与 Assets/app.svg 同源，视口 24x24）：
      圆角蓝底 + 白色蓝牙符号 + 右上角上传箭头。
      窗口 Icon、托盘 IconSource 均引用此 DrawingImage（矢量渲染，任意尺寸清晰）。
    -->
    <DrawingImage x:Key="AppIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 圆角背景 -->
                <GeometryDrawing Brush="{StaticResource BrandBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0.5,0.5,23,23" RadiusX="5.5" RadiusY="5.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 蓝牙符号（白色三段线） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="2.4" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 12,3.2 L 12,20.8 M 6.6,7.1 L 17.4,16.9 M 17.4,7.1 L 6.6,16.9"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 右上角上传箭头 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 18.4,3.8 L 18.4,9.4 M 16.5,5.7 L 18.4,9.4 L 20.3,5.7"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
