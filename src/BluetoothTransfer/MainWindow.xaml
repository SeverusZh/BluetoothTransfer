<Window x:Class="BluetoothTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BluetoothTransfer.ViewModels"
        xmlns:bh="clr-namespace:BluetoothTransfer.Behaviors"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="蓝牙传输" Height="720" Width="1180" MinHeight="560" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BackgroundBrush}"
        AllowDrop="True" Drop="OnFileDrop" DragOver="OnDragOver"
        Closing="OnClosing">
    <Window.DataContext>
        <vm:OppViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <!-- 托盘图标必须保留资源键 TrayIcon：MainWindow.xaml.cs 通过 FindResource("TrayIcon") 取用 -->
        <tb:TaskbarIcon x:Key="TrayIcon" ToolTipText="蓝牙传输"
                        TrayMouseDoubleClick="OnTrayDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="显示" Click="OnTrayShow"/>
                    <Separator/>
                    <!-- 资源管理器右键菜单安装/卸载：只写 HKCU，无需管理员权限；结果经状态栏/日志/气球提示反馈。
                         Win11 中静态 Verb 位于右键菜单的「显示更多选项」内，安装成功提示会说明。 -->
                    <MenuItem Header="安装资源管理器右键菜单" Click="OnTrayInstallExplorerMenu"/>
                    <MenuItem Header="移除资源管理器右键菜单" Click="OnTrayUninstallExplorerMenu"/>
                    <Separator/>
                    <MenuItem Header="退出" Click="OnTrayExit"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 顶栏：标题 + 全局操作 ================= -->
        <Border Grid.Row="0" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource AppIcon}" Width="34" Height="34"
                           VerticalAlignment="Center"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="蓝牙传输" Style="{StaticResource PageTitleTextStyle}"/>
                        <TextBlock Text="通用蓝牙推送 · Windows 互传 · 拖动文件到窗口即可发送"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="配对" Command="{Binding PairCommand}"/>
                    <Button Content="打开蓝牙设置" Command="{Binding OpenSettingsCommand}" Margin="8,0,0,0"/>
                    <Button Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButtonStyle}"
                            Margin="8,0,0,0" AutomationProperties.Name="扫描设备">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="扫描" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 主区：左设备 / 右发送与队列 ================= -->
        <!-- 主区外层滚动：窗口较小时（如 1366×768@125%）纵向滚动，内容不裁切。
             ScrollViewer 会使 Grid 的 * 行退化为 auto，因此关键容器显式设置了 MinHeight。
             水平方向不滚动：MinWidth 用 860 适配 940 最小窗口（客户区约 924，扣除 24×2 边距
             与垂直滚动条约 12 后可用约 864；原定 916 会在最小窗口下被裁切约 52px）。 -->
        <ScrollViewer Grid.Row="1" Focusable="False"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,16" MinHeight="520" MinWidth="860">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="384"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左栏：设备 + 接收助手 ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 设备列表 -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0" MinHeight="280">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,14,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="设备" Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBlock Text="{Binding Devices.Count, StringFormat={}共 {0} 台}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{Binding SelectedDevice.FavoriteDisplay, FallbackValue=☆}"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    Style="{StaticResource StarButtonStyle}"
                                    ToolTip="收藏/取消收藏当前设备"
                                    AutomationProperties.Name="收藏/取消收藏当前设备"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="8,0,8,8">
                            <ListView ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                      MinHeight="230"
                                      bh:HoverScrollBehavior.Enabled="True">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FavoriteDisplay}"
                                                       Foreground="{StaticResource StarBrush}" FontSize="14"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Style="{StaticResource BodyTextStyle}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Border Margin="8,0,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource SuccessChipStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="助手" Style="{StaticResource ChipTextStyle}"
                                                                   Foreground="{StaticResource SuccessBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding PairedDisplay}"
                                                               Style="{StaticResource CaptionTextStyle}"/>
                                                    <TextBlock Text="{Binding AddrDisplay}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{StaticResource TextTertiaryBrush}"
                                                               Margin="10,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE76C;"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 空状态 -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#xE702;" FontFamily="{StaticResource IconFont}"
                                           FontSize="28" Foreground="{StaticResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="未发现 OPP 设备" HorizontalAlignment="Center"
                                           Style="{StaticResource EmptyStateTitleTextStyle}"/>
                                <TextBlock Text="请确认对端已开启蓝牙并处于可发现状态，或先在系统设置中配对"
                                           MaxWidth="280" Margin="0,6,0,0"
                                           Style="{StaticResource EmptyStateTextStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 接收助手 -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="接收助手" Style="{StaticResource SectionTitleTextStyle}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="目录…" Command="{Binding BrowseReceiveDirCommand}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        AutomationProperties.Name="浏览接收目录"/>
                                <Button Content="{Binding ReceiveToggleText}" Command="{Binding ToggleReceiveCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="12,5"
                                        Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding ReceiveSaveDir}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>

                        <TextBlock Grid.Row="2" Text="{Binding ReceiveCurrentFile}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>

                        <ProgressBar Grid.Row="3" Value="{Binding ReceiveProgress}"
                                     Margin="0,8,0,0"/>

                        <TextBlock Grid.Row="4" Text="{Binding ReceiveProgressText}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,5,0,0"/>

                        <Grid Grid.Row="5" Height="92" Margin="0,10,0,0">
                            <ListBox ItemsSource="{Binding ReceiveCompleted}"
                                     ItemContainerStyle="{StaticResource CompactListBoxItemStyle}"
                                     FontSize="12"
                                     bh:HoverScrollBehavior.Enabled="True"/>
                            <TextBlock Text="本会话暂无接收文件" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{StaticResource TextTertiaryBrush}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReceiveCompleted.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <CheckBox Grid.Row="6" Content="每次接收前询问" IsChecked="{Binding ReceiveAsk}"
                                  Margin="0,10,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== 右栏：发送 + 队列 + 记录日志 ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 发送 -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="发送" Style="{StaticResource SectionTitleTextStyle}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="通道" Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="190" SelectedValue="{Binding SelectedTransferMode}"
                                          SelectedValuePath="Tag" VerticalAlignment="Center">
                                    <ComboBoxItem Content="自动（探测助手，否则 OPP）" Tag="auto"/>
                                    <ComboBoxItem Content="强制接收助手" Tag="assistant"/>
                                    <ComboBoxItem Content="强制 OPP" Tag="opp"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="68" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     Padding="10,8" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="发送文本" Command="{Binding SendTextCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="68" Width="96" Padding="0"/>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="发送文件" Command="{Binding SendFileCommand}"
                                    Padding="12,5" Margin="0,0,8,0"/>
                            <Button Content="文件夹 (zip)" Command="{Binding SendFolderCommand}"
                                    Padding="12,5" Margin="0,0,8,0"/>
                            <Button Content="剪贴板" Command="{Binding SendClipboardCommand}"
                                    Padding="12,5"/>
                            <!-- 外部待发送项：资源管理器右键菜单 / 「发送到」/ 二次实例转发进来的项目先缓冲在此，
                                 用户选定目标设备后点此按钮才真正入队发送（不自动发送，避免误发到错误设备）。
                                 HasPendingExternal 为 false 时整块隐藏；按钮使能由命令的 CanExecute 控制。 -->
                            <Button Command="{Binding SendPendingExternalCommand}"
                                    Margin="12,0,0,0" Padding="12,5"
                                    ToolTip="发送通过资源管理器右键菜单/「发送到」收到的待发送项（需先在设备列表中选中目标设备）"
                                    AutomationProperties.Name="发送待发送项">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPendingExternal}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="发送待发送项" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0" Value="{Binding TransferProgress}"
                                             Minimum="0" Maximum="100" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TransferProgress, StringFormat={}{0:F0}%}"
                                           Style="{StaticResource MetricTextStyle}"
                                           MinWidth="38" TextAlignment="Right" VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding ProgressText}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           MaxWidth="260" Margin="14,0,0,0"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding StatusText}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 任务队列 -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,14,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="任务队列" Style="{StaticResource SectionTitleTextStyle}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="取消全部" Command="{Binding CancelAllCommand}"
                                    Style="{StaticResource CompactDangerButtonStyle}"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="8,0,8,8">
                            <ListView ItemsSource="{Binding Jobs}" bh:HoverScrollBehavior.Enabled="True">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource BodyTextStyle}"
                                                           FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Style="{StaticResource ChipStyle}">
                                                        <TextBlock Text="{Binding ChannelDisplay}"
                                                                   Style="{StaticResource ChipTextStyle}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding StatusDisplay}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding Error}" Margin="10,0,0,0"
                                                               FontSize="12" Foreground="{StaticResource DangerBrush}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="240"
                                                               ToolTip="{Binding Error}" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Error}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button Content="暂停"
                                                        Command="{Binding DataContext.PauseJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CompactGhostButtonStyle}"/>
                                                <Button Content="继续"
                                                        Command="{Binding DataContext.ContinueJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CompactGhostButtonStyle}" Margin="4,0,0,0"/>
                                                <Button Content="移除"
                                                        Command="{Binding DataContext.RemoveJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CompactGhostButtonStyle}" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Text="队列为空" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Jobs.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 记录 / 日志 -->
                <!-- 高度约束（第 2 项修复）：主区外层 ScrollViewer 以无限高测量内容，Grid 星号行会退化为 auto，
                     若不给本 TabControl 上限，记录（最多 200 条）/日志会把它和整页撑到数千像素高。
                     这里统一限制 MinHeight/MaxHeight：内容在固定范围内由内部 ListView/ListBox 滚动，
                     页面总高不再随记录数无限增长；窗口过小时仍由外层 ScrollViewer 兜底纵向滚动。 -->
                <TabControl Grid.Row="4" MinHeight="280" MaxHeight="440">
                    <TabItem Header="传输记录">
                        <Grid Margin="12,10,12,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="刷新" Command="{Binding RefreshRecordsCommand}"
                                            FontSize="12" Padding="12,4"
                                            AutomationProperties.Name="刷新传输记录"/>
                                    <Button Content="导出 CSV" Command="{Binding ExportCsvCommand}"
                                            FontSize="12" Padding="12,4" Margin="8,0,0,0"/>
                                    <Button Content="导出 JSON" Command="{Binding ExportJsonCommand}"
                                            FontSize="12" Padding="12,4" Margin="8,0,0,0"/>
                                    <Button Content="清空" Command="{Binding ClearRecordsCommand}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            FontSize="12" Padding="12,4" Margin="8,0,0,0"
                                            AutomationProperties.Name="清空传输记录"/>
                                </StackPanel>
                                <!-- 说明文案与 RecordsPaneController.DisplayLimit（GetRecords limit:200）保持一致：
                                     列表仅展示最近 200 条、不删除数据库数据，完整记录可用导出功能获取。 -->
                                <TextBlock Grid.Column="1" Text="{Binding RecordsLimitText}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"
                                           ToolTip="记录按时间倒序仅展示最近 200 条；完整记录可用 CSV/JSON 导出"
                                           AutomationProperties.Name="记录展示上限说明"/>
                            </Grid>

                            <!-- 表头与行对齐依据：行内容起点 = ListViewItem 1px 边框 + 行 Border Padding 8 = 9px，
                                 故表头 Border Padding 用 9,4；右侧 Margin 12 预留垂直滚动条宽度，两处 Grid 星号列宽一致。
                                 新增「操作」列后各固定列宽度做了小幅收窄，表格总宽与改动前基本一致，列定义必须与行模板逐列保持同步。 -->
                            <Border Grid.Row="1" Style="{StaticResource TableHeaderStyle}"
                                    Padding="9,4" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="118"/>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="时间" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="1" Text="方向" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="2" Text="类型" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="3" Text="对端" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="4" Text="名称" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="5" Text="大小" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="6" Text="状态" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="7" Text="通道" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="8" Text="备注" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="9" Text="操作" Style="{StaticResource TableHeaderTextStyle}"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,4,0,0">
                                <ListView ItemsSource="{Binding Records}"
                                          MinHeight="140"
                                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                                          bh:HoverScrollBehavior.Enabled="True">
                                    <!-- 清除隐式 ListViewItem 的 Padding 10,7（否则行内容会再左移 10px），
                                         行内边距统一由 DataTemplate 的 Border Padding 8,6 控制。 -->
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource GridLineBrush}"
                                                    BorderThickness="0,0,0,1" Padding="8,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="118"/>
                                                        <ColumnDefinition Width="38"/>
                                                        <ColumnDefinition Width="38"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="56"/>
                                                        <ColumnDefinition Width="46"/>
                                                        <ColumnDefinition Width="38"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="48"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding CreatedAtDisplay}"
                                                               Style="{StaticResource TableCellSecondaryTextStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DirectionDisplay}"
                                                               Style="{StaticResource TableCellSecondaryTextStyle}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding TypeDisplay}"
                                                               Style="{StaticResource TableCellSecondaryTextStyle}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding PeerName}"
                                                               Style="{StaticResource TableCellTextStyle}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Name}"
                                                               Style="{StaticResource TableCellTextStyle}"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding SizeDisplay}"
                                                               Style="{StaticResource TableCellSecondaryTextStyle}"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding StatusDisplay}"
                                                               Style="{StaticResource TableCellTextStyle}"/>
                                                    <TextBlock Grid.Column="7" Text="{Binding ChannelDisplay}"
                                                               Style="{StaticResource TableCellSecondaryTextStyle}"/>
                                                    <TextBlock Grid.Column="8" Text="{Binding Note}"
                                                               ToolTip="{Binding Note}"
                                                               Style="{StaticResource TableCellSecondaryTextStyle}"/>
                                                    <!-- 操作列：每行通用复制（把传输对象放进剪贴板）；单文件记录额外提供「复制内容」。
                                                         命令在 OppViewModel，参数经 CommandParameter 传入当前行记录；失败会给出中文状态栏提示。 -->
                                                    <StackPanel Grid.Column="9" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Command="{Binding DataContext.CopyRecordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource CompactGhostButtonStyle}"
                                                                Padding="3,2" MinHeight="20" MinWidth="20"
                                                                ToolTip="复制到剪贴板（文本→文本、图片→图片、其它文件→文件）"
                                                                AutomationProperties.Name="复制到剪贴板">
                                                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}"
                                                                       FontSize="12" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Button>
                                                        <Button Command="{Binding DataContext.CopyRecordContentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="3,2" MinHeight="20" MinWidth="20" Margin="2,0,0,0"
                                                                ToolTip="复制文件内容（文本文件→文本、图片→图片，其它格式复制文件本身）"
                                                                AutomationProperties.Name="复制文件内容">
                                                            <Button.Style>
                                                                <Style TargetType="Button"
                                                                       BasedOn="{StaticResource CompactGhostButtonStyle}">
                                                                    <!-- 单文件记录（Type=file）才显示专属「复制内容」图标；
                                                                         文件缺失时点击仍会得到中文提示，不做静默隐藏。 -->
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFileRecord}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}"
                                                                       FontSize="12" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock Text="暂无传输记录" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{StaticResource TextTertiaryBrush}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Records.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="日志">
                        <Grid Margin="12,10,12,12">
                            <ListBox x:Name="LogListBox" ItemsSource="{Binding LogLines}"
                                     MinHeight="140"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ItemContainerStyle="{StaticResource CompactListBoxItemStyle}"
                                     bh:HoverScrollBehavior.Enabled="True"/>
                            <TextBlock Text="暂无日志" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LogLines.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextStyle}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
