<Window x:Class="BluetoothTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BluetoothTransfer.ViewModels"
        xmlns:bh="clr-namespace:BluetoothTransfer.Behaviors"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="蓝牙传输" Height="820" Width="1280" MinHeight="760" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BackgroundBrush}"
        AllowDrop="True" Drop="OnFileDrop" DragOver="OnDragOver"
        Closing="OnClosing">
    <Window.DataContext>
        <vm:OppViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <!-- 托盘图标必须保留资源键 TrayIcon：MainWindow.xaml.cs 通过 FindResource("TrayIcon") 取用 -->
        <tb:TaskbarIcon x:Key="TrayIcon" ToolTipText="蓝牙传输"
                        TrayMouseDoubleClick="OnTrayDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="显示" Click="OnTrayShow"/>
                    <Separator/>
                    <MenuItem Header="退出" Click="OnTrayExit"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 顶栏：标题 + 全局操作 ================= -->
        <Border Grid.Row="0" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource AppIcon}" Width="34" Height="34"
                           VerticalAlignment="Center"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="蓝牙传输" Style="{StaticResource PageTitleTextStyle}"/>
                        <TextBlock Text="通用蓝牙推送 · Windows 互传 · 拖动文件到窗口即可发送"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="配对" Command="{Binding PairCommand}"/>
                    <Button Content="打开蓝牙设置" Command="{Binding OpenSettingsCommand}" Margin="8,0,0,0"/>
                    <Button Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButtonStyle}"
                            Margin="8,0,0,0" AutomationProperties.Name="扫描设备">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="扫描" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 主区：左设备 / 右发送与队列 ================= -->
        <Grid Grid.Row="1" Margin="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="384"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左栏：设备 + 接收助手 ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 设备列表 -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,14,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="设备" Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBlock Text="{Binding Devices.Count, StringFormat={}共 {0} 台}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{Binding SelectedDevice.FavoriteDisplay, FallbackValue=☆}"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    Style="{StaticResource StarButtonStyle}"
                                    ToolTip="收藏/取消收藏当前设备"
                                    AutomationProperties.Name="收藏/取消收藏当前设备"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="8,0,8,8">
                            <ListView ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                      bh:HoverScrollBehavior.Enabled="True">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FavoriteDisplay}"
                                                       Foreground="{StaticResource StarBrush}" FontSize="14"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Style="{StaticResource BodyTextStyle}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Border Margin="8,0,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource SuccessChipStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="助手" Style="{StaticResource ChipTextStyle}"
                                                                   Foreground="{StaticResource SuccessBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding PairedDisplay}"
                                                               Style="{StaticResource CaptionTextStyle}"/>
                                                    <TextBlock Text="{Binding AddrDisplay}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{StaticResource TextTertiaryBrush}"
                                                               Margin="10,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE76C;"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 空状态 -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#xE702;" FontFamily="{StaticResource IconFont}"
                                           FontSize="28" Foreground="{StaticResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="未发现 OPP 设备" HorizontalAlignment="Center"
                                           Style="{StaticResource EmptyStateTitleTextStyle}"/>
                                <TextBlock Text="请确认对端已开启蓝牙并处于可发现状态，或先在系统设置中配对"
                                           MaxWidth="280" Margin="0,6,0,0"
                                           Style="{StaticResource EmptyStateTextStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 接收助手 -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="接收助手" Style="{StaticResource SectionTitleTextStyle}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="目录…" Command="{Binding BrowseReceiveDirCommand}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        AutomationProperties.Name="浏览接收目录"/>
                                <Button Content="{Binding ReceiveToggleText}" Command="{Binding ToggleReceiveCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="12,5"
                                        Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding ReceiveSaveDir}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>

                        <TextBlock Grid.Row="2" Text="{Binding ReceiveCurrentFile}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>

                        <ProgressBar Grid.Row="3" Value="{Binding ReceiveProgress}"
                                     Margin="0,8,0,0"/>

                        <TextBlock Grid.Row="4" Text="{Binding ReceiveProgressText}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,5,0,0"/>

                        <Grid Grid.Row="5" Height="92" Margin="0,10,0,0">
                            <ListBox ItemsSource="{Binding ReceiveCompleted}"
                                     ItemContainerStyle="{StaticResource CompactListBoxItemStyle}"
                                     FontSize="12"
                                     bh:HoverScrollBehavior.Enabled="True"/>
                            <TextBlock Text="本会话暂无接收文件" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{StaticResource TextTertiaryBrush}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReceiveCompleted.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <CheckBox Grid.Row="6" Content="每次接收前询问" IsChecked="{Binding ReceiveAsk}"
                                  Margin="0,10,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== 右栏：发送 + 队列 + 记录日志 ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 发送 -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="发送" Style="{StaticResource SectionTitleTextStyle}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="通道" Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="190" SelectedValue="{Binding SelectedTransferMode}"
                                          SelectedValuePath="Tag" VerticalAlignment="Center">
                                    <ComboBoxItem Content="自动（探测助手，否则 OPP）" Tag="auto"/>
                                    <ComboBoxItem Content="强制接收助手" Tag="assistant"/>
                                    <ComboBoxItem Content="强制 OPP" Tag="opp"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="68" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     Padding="10,8" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="发送文本" Command="{Binding SendTextCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="68" Width="96" Padding="0"/>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="发送文件" Command="{Binding SendFileCommand}"
                                    Padding="12,5" Margin="0,0,8,0"/>
                            <Button Content="文件夹 (zip)" Command="{Binding SendFolderCommand}"
                                    Padding="12,5" Margin="0,0,8,0"/>
                            <Button Content="剪贴板" Command="{Binding SendClipboardCommand}"
                                    Padding="12,5"/>
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0" Value="{Binding TransferProgress}"
                                             Minimum="0" Maximum="100" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TransferProgress, StringFormat={}{0:F0}%}"
                                           Style="{StaticResource MetricTextStyle}"
                                           MinWidth="38" TextAlignment="Right" VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding ProgressText}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           MaxWidth="260" Margin="14,0,0,0"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding StatusText}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 任务队列 -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,14,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="任务队列" Style="{StaticResource SectionTitleTextStyle}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="取消全部" Command="{Binding CancelAllCommand}"
                                    Style="{StaticResource CompactDangerButtonStyle}"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="8,0,8,8">
                            <ListView ItemsSource="{Binding Jobs}" bh:HoverScrollBehavior.Enabled="True">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource BodyTextStyle}"
                                                           FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Style="{StaticResource ChipStyle}">
                                                        <TextBlock Text="{Binding ChannelDisplay}"
                                                                   Style="{StaticResource ChipTextStyle}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding StatusDisplay}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding Error}" Margin="10,0,0,0"
                                                               FontSize="12" Foreground="{StaticResource DangerBrush}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="240"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Error}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button Content="暂停"
                                                        Command="{Binding DataContext.PauseJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CompactGhostButtonStyle}"/>
                                                <Button Content="继续"
                                                        Command="{Binding DataContext.ContinueJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CompactGhostButtonStyle}" Margin="4,0,0,0"/>
                                                <Button Content="移除"
                                                        Command="{Binding DataContext.RemoveJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CompactGhostButtonStyle}" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Text="队列为空" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Jobs.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 记录 / 日志 -->
                <TabControl Grid.Row="4">
                    <TabItem Header="传输记录">
                        <Grid Margin="12,10,12,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="刷新" Command="{Binding RefreshRecordsCommand}"
                                        FontSize="12" Padding="12,4"
                                        AutomationProperties.Name="刷新传输记录"/>
                                <Button Content="导出 CSV" Command="{Binding ExportCsvCommand}"
                                        FontSize="12" Padding="12,4" Margin="8,0,0,0"/>
                                <Button Content="导出 JSON" Command="{Binding ExportJsonCommand}"
                                        FontSize="12" Padding="12,4" Margin="8,0,0,0"/>
                                <Button Content="清空" Command="{Binding ClearRecordsCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        FontSize="12" Padding="12,4" Margin="8,0,0,0"
                                        AutomationProperties.Name="清空传输记录"/>
                            </StackPanel>

                            <Border Grid.Row="1" Style="{StaticResource TableHeaderStyle}" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="118"/>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="时间" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="1" Text="方向" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="2" Text="类型" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="3" Text="对端" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="4" Text="名称" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="5" Text="大小" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="6" Text="状态" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="7" Text="通道" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="8" Text="备注" Style="{StaticResource TableHeaderTextStyle}"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,4,0,0">
                                <ListView ItemsSource="{Binding Records}"
                                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                                          bh:HoverScrollBehavior.Enabled="True">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource GridLineBrush}"
                                                    BorderThickness="0,0,0,1" Padding="8,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="118"/>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="92"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="62"/>
                                                        <ColumnDefinition Width="54"/>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding CreatedAtDisplay}"
                                                               Style="{StaticResource TableCellSecondaryTextStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DirectionDisplay}"
                                                               Style="{StaticResource TableCellSecondaryTextStyle}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding TypeDisplay}"
                                                               Style="{StaticResource TableCellSecondaryTextStyle}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding PeerName}"
                                                               Style="{StaticResource TableCellTextStyle}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Name}"
                                                               Style="{StaticResource TableCellTextStyle}"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding SizeDisplay}"
                                                               Style="{StaticResource TableCellSecondaryTextStyle}"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding StatusDisplay}"
                                                               Style="{StaticResource TableCellTextStyle}"/>
                                                    <TextBlock Grid.Column="7" Text="{Binding ChannelDisplay}"
                                                               Style="{StaticResource TableCellSecondaryTextStyle}"/>
                                                    <TextBlock Grid.Column="8" Text="{Binding Note}"
                                                               ToolTip="{Binding Note}"
                                                               Style="{StaticResource TableCellSecondaryTextStyle}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock Text="暂无传输记录" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{StaticResource TextTertiaryBrush}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Records.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="日志">
                        <Grid Margin="12,10,12,12">
                            <ListBox x:Name="LogListBox" ItemsSource="{Binding LogLines}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ItemContainerStyle="{StaticResource CompactListBoxItemStyle}"
                                     bh:HoverScrollBehavior.Enabled="True"/>
                            <TextBlock Text="暂无日志" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LogLines.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextStyle}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
