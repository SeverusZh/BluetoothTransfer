<Window x:Class="BluetoothTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BluetoothTransfer.ViewModels"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="蓝牙传输" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnFileDrop" DragOver="OnDragOver"
        Closing="OnClosing">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon" ToolTipText="蓝牙传输"
                        TrayMouseDoubleClick="OnTrayDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="显示" Click="OnTrayShow"/>
                    <Separator/>
                    <MenuItem Header="退出" Click="OnTrayExit"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="双端互联 (1.0)">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0" Grid.Row="0" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="10">
                                <TextBlock Text="设备" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,8"
                                         ToolTip="本机广播名称"/>
                                <Button Content="{Binding AdvertiseButtonText}" Command="{Binding AdvertiseCommand}" Height="28" Margin="0,0,0,8"/>
                                <Button Content="{Binding ScanButtonText}" Command="{Binding ScanCommand}" Height="32" Margin="0,0,0,8"/>
                                <Button Content="断开连接" Command="{Binding DisconnectCommand}" Height="28" Margin="0,0,0,8"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Bottom" Content="连接" Command="{Binding ConnectCommand}"
                                    Height="32" Margin="10,5,10,10"/>
                            <ListView ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                      Margin="5,0,5,5" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Addr}" FontSize="11" Foreground="Gray"/>
                                                <TextBlock Text="{Binding Rssi, StringFormat=' | {0} dBm'}" FontSize="11" Foreground="Gray"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="1" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="150"/>
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="发送" Margin="10,10,10,5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
                                             Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="发送文本" Command="{Binding SendTextCommand}" Height="50"/>
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="发送文件" Command="{Binding SendFileCommand}" Padding="12,5" Margin="0,0,8,0"/>
                                    <ProgressBar Width="200" Height="20" Value="{Binding TransferProgress}" Minimum="0" Maximum="100" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding TransferProgress, StringFormat={}{0:F0}%}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="接收文本" Margin="10,5,10,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ReceivedText, Mode=OneWay}" IsReadOnly="True"
                                         Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="复制" Command="{Binding CopyReceivedCommand}" Height="60"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="传输记录" Margin="10,5,10,5">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                                    <Button Content="刷新" Command="{Binding RefreshRecordsCommand}" Padding="10,3" Margin="0,0,5,0"/>
                                    <Button Content="导出 CSV" Command="{Binding ExportCsvCommand}" Padding="10,3" Margin="0,0,5,0"/>
                                    <Button Content="导出 JSON" Command="{Binding ExportJsonCommand}" Padding="10,3"/>
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding Records}" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
                                          BorderThickness="1" BorderBrush="#DDD">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="时间" Binding="{Binding CreatedAtDisplay}" Width="140"/>
                                        <DataGridTextColumn Header="方向" Binding="{Binding DirectionDisplay}" Width="50"/>
                                        <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplay}" Width="50"/>
                                        <DataGridTextColumn Header="对端" Binding="{Binding PeerName}" Width="100"/>
                                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="70"/>
                                        <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay}" Width="60"/>
                                        <DataGridTextColumn Header="通道" Binding="{Binding ChannelDisplay}" Width="60"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="3" Header="日志" Margin="10,5,10,10">
                            <ListBox ItemsSource="{Binding LogLines}" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="11"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="通用推送 (1.1)">
                <TabItem.DataContext>
                    <vm:OppViewModel/>
                </TabItem.DataContext>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="130"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="仅发送端需要本应用：向任意支持“蓝牙文件接收”（OPP）的设备推送文件（Android 手机/平板、Windows 电脑等）。接收端无需运行本应用，但需先配对（可在此处或系统设置中完成）；iPhone 不支持蓝牙文件接收。Android 接收时请保持屏幕点亮并留意通知栏的“接受文件”提示；部分机型（如小米 MIUI）没有独立的“接收文件”开关，接收默认开启。"
                               TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="扫描" Command="{Binding ScanCommand}" Padding="12,5" Margin="0,0,8,0"/>
                        <Button Content="配对" Command="{Binding PairCommand}" Padding="12,5" Margin="0,0,8,0"/>
                        <Button Content="打开蓝牙设置" Command="{Binding OpenSettingsCommand}" Padding="12,5" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <ListView Grid.Row="2" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                              BorderThickness="1" BorderBrush="#DDD">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding PairedDisplay}" FontSize="11" Foreground="Gray"
                                                   Margin="8,1,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding AddrDisplay}" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <GroupBox Grid.Row="3" Header="发送" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="46" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="发送文本" Command="{Binding SendTextCommand}" Height="46"/>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,4">
                                <Button Content="发送文件" Command="{Binding SendFileCommand}" Padding="12,5" Margin="0,0,8,0"/>
                                <Button Content="发送文件夹 (zip)" Command="{Binding SendFolderCommand}" Padding="12,5" Margin="0,0,8,0"/>
                                <ProgressBar Width="180" Height="20" Value="{Binding TransferProgress}" Minimum="0" Maximum="100" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding TransferProgress, StringFormat={}{0:F0}%}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="4" Header="日志" Margin="0,8,0,0">
                        <ListBox ItemsSource="{Binding LogLines}" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="11"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="#F0F0F0" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="10,0" FontSize="12"/>
        </Border>
    </Grid>
</Window>
