<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>btrecv</AssemblyName>
    <RootNamespace>BluetoothTransfer.Receiver</RootNamespace>
    <Version>1.3.0</Version>
    <!-- PublishCliOnly=true 时编译为纯 CLI 形态（剔除 WPF 壳），配合裁剪显著缩小引导包体积 -->
    <UseWPF Condition="'$(PublishCliOnly)' != 'true'">true</UseWPF>
    <DefineConstants Condition="'$(PublishCliOnly)' == 'true'">$(DefineConstants);CLI_ONLY</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishCliOnly)' == 'true'">
    <Page Remove="ReceiverWindow.xaml" />
    <Compile Remove="ReceiverWindow.xaml.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BluetoothTransfer.Core\BluetoothTransfer.Core.csproj" />
  </ItemGroup>

</Project>
